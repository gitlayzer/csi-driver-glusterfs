root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[*.{yaml,yml,md,json,ts,js,sh}]
indent_style = space
indent_size = 2

[*.mk]
indent_style = tab

[Makefile]
indent_style = tab

[*.{sum,mod}]
insert_final_newline = true
